{
  "manifest_version": 3,
  "name": "Mark As Seen",
  "version": "0.1.0",
  "description": "Marks the current YouTube video as seen by automating the share-link redirect flow.",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Mark current YouTube video as seen"
  }
}
