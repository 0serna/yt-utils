{
  "name": "yt-utils",
  "version": "0.1.0",
  "description": "A Chrome extension with YouTube helpers and inline search utilities.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "flock /tmp/yt-utils-build.lock vite build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.1.40",
    "@types/node": "^25.6.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "typescript": "^6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
