{
	"name": "yt-utils",
	"version": "0.1.0",
	"description": "A set of YouTube utilities delivered as a Chrome extension.",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check": "biome check .",
		"check:staged": "biome check --staged --write .",
		"check:write": "biome check --write .",
		"format": "biome format --write .",
		"prepare": "husky",
		"lint": "biome lint .",
		"watch": "vite build --watch",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.11",
		"@crxjs/vite-plugin": "^2.0.0",
		"@types/chrome": "^0.1.40",
		"@types/node": "^25.6.0",
		"husky": "^9.1.7",
		"typescript": "^6.0.2",
		"vite": "^8.0.8"
	}
}
