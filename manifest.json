{
  "manifest_version": 3,
  "name": "YT Utils",
  "version": "0.1.0",
  "description": "A Chrome extension with YouTube helpers and inline search utilities.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/main-world/youtube-player-bridge.ts"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/global-selection.ts"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "YT Utils"
  }
}
